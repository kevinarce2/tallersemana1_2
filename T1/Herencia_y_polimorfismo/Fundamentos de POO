import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.io.File;
import javax.sound.sampled.*;

public class ReproductorMusica extends JFrame {

    private JButton btnCargar, btnPlay, btnPause, btnStop;
    private JLabel lblCancion;
    private Clip clip;
    private AudioInputStream audioStream;
    private File archivo;

    public ReproductorMusica() {
        setTitle("APP Reproductor de Música");
        setSize(400, 250);
        setDefaultCloseOperation(EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new FlowLayout());

        lblCancion = new JLabel("Ninguna canción cargada");

        btnCargar = new JButton("Cargar Música");
        btnPlay = new JButton("Play");
        btnPause = new JButton("Pause");
        btnStop = new JButton("Stop");

        add(lblCancion);
        add(btnCargar);
        add(btnPlay);
        add(btnPause);
        add(btnStop);

        btnCargar.addActionListener(e -> cargarMusica());
        btnPlay.addActionListener(e -> reproducir());
        btnPause.addActionListener(e -> pausar());
        btnStop.addActionListener(e -> detener());

        setVisible(true);
    }

    private void cargarMusica() {
        JFileChooser chooser = new JFileChooser();
        int opcion = chooser.showOpenDialog(this);

        if (opcion == JFileChooser.APPROVE_OPTION) {
            archivo = chooser.getSelectedFile();
            lblCancion.setText("Cargado: " + archivo.getName());

            try {
                if (clip != null) {
                    clip.close();
                }

                audioStream = AudioSystem.getAudioInputStream(archivo);
                clip = AudioSystem.getClip();
                clip.open(audioStream);

            } catch (Exception ex) {
                JOptionPane.showMessageDialog(this, "Error al cargar archivo");
            }
        }
    }

    private void reproducir() {
        if (clip != null) {
            clip.start();
        }
    }

    private void pausar() {
        if (clip != null) {
            clip.stop();
        }
    }

    private void detener() {
        if (clip != null) {
            clip.stop();
            clip.setFramePosition(0);
        }
    }

    public static void main(String[] args) {
        new ReproductorMusica();
    }
}
